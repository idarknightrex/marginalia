{
  "_comment": "Marginalia settings \u2014 human readable, travels with your repo, committed to git",
  "_docs": "All values editable here or via Settings panel in the UI",
  "disposition": "balance",
  "models": {
    "cloud": {
      "anthropic": "claude-haiku-4-5",
      "gemini": "gemini-2.5-flash",
      "openai": "gpt-4o"
    },
    "local": {
      "asia": "qwen2.5:14b",
      "europe": "mistral:7b",
      "general": "llama3.1:8b",
      "multimodal": "gemma4:latest",
      "reasoning": "deepseek-r1:8b"
    }
  },
  "projects": {
    "types": [
      "PhD",
      "Masters",
      "Paper",
      "Conference",
      "Course",
      "Other"
    ]
  },
  "storage": {
    "canonical_folder": "canonical",
    "captures_folder": "canonical/captures",
    "exports_folder": "exports",
    "pdf_folder": "~/Documents/Research/PDFs"
  },
  "ui": {
    "port": 5000,
    "reading_assistant_enabled": false,
    "theme": "default"
  },
  "workflow": {
    "auto_save_canonical": true,
    "break_reminder_minutes": 120,
    "default_verification_status": "located",
    "dwell_threshold_seconds": 30,
    "upgrade_check_days": 30
  }
}