# Marginalia API Keys — copy this file to .env and fill in your keys
# .env is gitignored and never committed

# Google Gemini (free tier — get key at aistudio.google.com)
GOOGLE_API_KEY=your_key_here

# Microsoft Azure OpenAI (institutional — get from portal.azure.com)
AZURE_OPENAI_KEY=your_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_DEPLOYMENT_NAME=gpt-4o

# Anthropic Claude (optional — get key at console.anthropic.com)
ANTHROPIC_API_KEY=your_key_here
